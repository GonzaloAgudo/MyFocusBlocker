<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0E0F1A"
    android:padding="32dp">

    <TextView
        android:id="@+id/blockEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="72sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/blockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiempo de concentración"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/blockApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B9BCD0"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/blockReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8A8DA3"
        android:textSize="15sp"
        android:layout_marginTop="20dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/blockExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver al inicio"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="28dp"
        android:backgroundTint="#5B6CFF"
        android:textColor="#FFFFFF"/>

</LinearLayout>
